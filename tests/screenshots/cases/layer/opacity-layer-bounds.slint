// Faded items whose children draw outside the faded item's own geometry:
// a drop shadow, a child at a negative position, a rotated child, and a clip with a radius.
// None of it may be cut off.

//ignore: software, software-embed-assets, anyrender, vello_cpu

component Card {
    in property <brush> color;
    width: 36px;
    height: 48px;

    Rectangle {
        drop-shadow-color: #000c;
        drop-shadow-offset-y: 6px;
        drop-shadow-blur: 10px;
        border-radius: 6px;
        background: white;
    }

    Rectangle {
        clip: true;
        border-radius: 6px;
        Rectangle {
            x: -10px;
            width: 40px;
            height: 30px;
            background: root.color;
        }
    }

    Rectangle {
        x: -8px;
        y: 30px;
        width: 14px;
        height: 14px;
        background: orange;
        border-radius: 7px;
        border-width: 2px;
        border-color: black;
    }

    Rectangle {
        x: 28px;
        y: -6px;
        width: 14px;
        height: 6px;
        background: magenta;
        transform-rotation: 30deg;
    }
}

export component TestCase inherits Window {
    width: 160px;
    height: 80px;
    background: #446;

    Card {
        x: 12.5px;
        y: 10px;
        color: blue;
        opacity: 0.4;
    }

    Card {
        x: 62px;
        y: 10.25px;
        color: green;
        opacity: 1;
    }

    Card {
        x: 110px;
        y: 10px;
        color: red;
        opacity: 0.7;
    }
}

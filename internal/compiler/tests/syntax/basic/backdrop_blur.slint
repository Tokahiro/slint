export component Test inherits Window {
    backdrop-blur: 4px;
//                 >  <warning{'backdrop-blur' has no effect on the root element; set it on a child 'Rectangle'}

    Text {
        backdrop-blur: 4px;
//                     >  <error{'backdrop-blur' only works on a 'Rectangle'; set it on a 'Rectangle' behind this element}
    }

    Rectangle {
        backdrop-blur: 4px;
    }

    Image {
        backdrop-refraction: 12px;
//                           >   <error{'backdrop-refraction' only works on a 'Rectangle'; set it on a 'Rectangle' behind this element}
    }

    Rectangle {
        backdrop-refraction: 12px;
        backdrop-bezel: 20px;
        backdrop-dispersion: 0.03;
        backdrop-edge-light: 0.5;
    }
}
